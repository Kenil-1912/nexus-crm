# Copy to .env and adjust.
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus_crm
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Where the React app runs; used to build links in emails.
APP_URL=http://localhost:5173

# Email. Leave SMTP_HOST empty in development: emails are then saved to the
# email_log table (visible on the staff "Email log" page) instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RIC Admissions <admissions@example.com>"
